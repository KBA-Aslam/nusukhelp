{
  "name": "nusukhelp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "postinstall": "wrangler types --env-interface CloudflareEnv",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply nusukhelp-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nusukhelp-db --remote",
    "seed:admin:local": "node scripts/seed-admin.mjs --local",
    "seed:admin:remote": "node scripts/seed-admin.mjs --remote",
    "check:timestamps:local": "node scripts/check-timestamps.mjs --local",
    "check:timestamps:remote": "node scripts/check-timestamps.mjs --remote"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.23",
    "next-intl": "^4.13.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "jsdom": "^30.0.1",
    "miniflare": "^5.20260815.0-alpha",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.123.0"
  }
}
